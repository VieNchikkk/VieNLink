<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Светлая тема: тёплая бумага дневника, белые карточки и лесной зелёный акцент. -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFF2F4F0" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFF8FAF7" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ChipBrush" Color="#FFEAF2EB" />
    <SolidColorBrush x:Key="InnerBrush" Color="#FFF2F5F1" />
    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#FFEDF1EC" />

    <SolidColorBrush x:Key="BorderBrush" Color="#FFDCE3DB" />
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#FFD6DED7" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#FFC2CCC4" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#FF9DAAA1" />

    <SolidColorBrush x:Key="TextBrush" Color="#FF1E2621" />
    <SolidColorBrush x:Key="TextStrongBrush" Color="#FF111814" />
    <SolidColorBrush x:Key="TextSoftBrush" Color="#FF2F3B34" />
    <SolidColorBrush x:Key="MutedBrush" Color="#FF68746D" />
    <SolidColorBrush x:Key="MutedStrongBrush" Color="#FF45514A" />

    <SolidColorBrush x:Key="AccentBrush" Color="#FF2E7D52" />
    <SolidColorBrush x:Key="AccentContrastBrush" Color="#FFFFFFFF" />

    <!-- Подсветка важных действий «второго плана»: тонированная плашка в цвет акцента. -->
    <SolidColorBrush x:Key="AccentSurfaceBrush" Color="#FFE7F4EC" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#FF9CCBB0" />
    <SolidColorBrush x:Key="PositiveTextBrush" Color="#FF2E7D52" />

    <SolidColorBrush x:Key="DangerBrush" Color="#FFB7303F" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FFFCEAEC" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#FFF6D7DB" />

    <SolidColorBrush x:Key="PlaceholderBrush" Color="#FF939D97" />
    <SolidColorBrush x:Key="PlaceholderIconBrush" Color="#FFB6C0B9" />

    <SolidColorBrush x:Key="WarningBrush" Color="#FFA26A00" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#33E0A100" />

    <SolidColorBrush x:Key="TableBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TableRowBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TableAlternateRowBrush" Color="#FFF7F9F6" />
    <SolidColorBrush x:Key="MaskedRowBrush" Color="#FFFFF3B0" />
    <SolidColorBrush x:Key="WorkingRowBrush" Color="#FFE4F5E8" />
    <SolidColorBrush x:Key="UntestedRowBrush" Color="#FFFCE4E4" />
    <SolidColorBrush x:Key="TableGridLineBrush" Color="#FFE5EAE4" />
    <SolidColorBrush x:Key="TableHoverBrush" Color="#FFEDF3ED" />
    <SolidColorBrush x:Key="TableSelectionBrush" Color="#FFDCEBE0" />
    <SolidColorBrush x:Key="TableHeaderHoverBrush" Color="#FFF0F5F0" />

    <SolidColorBrush x:Key="TabHoverBrush" Color="#FFEFF4EF" />
    <SolidColorBrush x:Key="TabSelectedBrush" Color="#FFE6EFE7" />
    <SolidColorBrush x:Key="TabSelectedStrongBrush" Color="#FFDCE9DF" />

    <SolidColorBrush x:Key="ToggleTrackBrush" Color="#FFC7D0C9" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#FFC3CCC5" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#FFA9B5AC" />
    <SolidColorBrush x:Key="ScrollThumbDragBrush" Color="#FF93A098" />
</ResourceDictionary>
