                        <CheckBox x:Name="TestAfterRefreshCheck" Content="Проверять задержки сразу после обновления списков" Style="{StaticResource AppCheckBox}" Margin="0,4" />
                        <StackPanel Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Защита и статистика" Margin="0,20,0,8" />
                        <CheckBox x:Name="KillSwitchCheck" Content="Kill switch: при падении ядра не выпускать трафик напрямую" Style="{StaticResource AppCheckBox}" Margin="0,4"
                                  ToolTip="Системный прокси останется на закрытом локальном порту: сайты не откроются, но трафик не пойдёт в обход узла. Вернуть интернет — кнопкой «Отключиться»" />
                        <CheckBox x:Name="ShowTrafficCheck" Content="Показывать скорость и трафик в шапке" Style="{StaticResource AppCheckBox}" Margin="0,4" />
                        <CheckBox x:Name="ShowExitInfoCheck" Content="Показывать страну и IP выхода после подключения" Style="{StaticResource AppCheckBox}" Margin="0,4"
                                  ToolTip="Один запрос через узел: полезно видеть, куда выпускает случайный бесплатный сервер" />
                        </StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Фоновая проверка узлов" Margin="0,20,0,8" />
