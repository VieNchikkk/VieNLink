<TabItem x:Name="TunBypassTab" Header="TUN-обход (бета)" Style="{StaticResource AppTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,12,16,24" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="TUN-обход без прокси-узла" />
                        <TextBlock Text="Статус: в разработке — экспериментально, возможны сбои" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="TunBypassStatusText" Style="{StaticResource HintText}" TextWrapping="Wrap" Text="Проверка…" />
                        <TextBlock x:Name="TunBypassActiveText" Style="{StaticResource HintText}" Margin="0,4,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="TunBypassToggleButton" Content="Включить TUN-обход" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
