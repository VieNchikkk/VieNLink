<Window x:Class="VieNLink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VieNLink (бета) — свободные узлы"
        Icon="pack://application:,,,/Assets/VieNLink.ico"
        Height="720" Width="1080"
        MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="13">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шапка: состояние и главные действия -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource TableGridLineBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{DynamicResource MutedBrush}" VerticalAlignment="Top" Margin="0,7,10,0" />
                    <StackPanel>
                        <TextBlock x:Name="StatusText" Text="Отключено" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}" />
                        <TextBlock x:Name="StatusDetail" Style="{StaticResource HintText}" Text="Списки узлов ещё не загружены" />
                    </StackPanel>
                    <Border Background="{DynamicResource WarningSurfaceBrush}" CornerRadius="4" Padding="6,2"
                            Margin="10,2,0,0" VerticalAlignment="Top"
                            ToolTip="Бета-версия: основные режимы проверены, но возможны сбои">
                        <TextBlock Text="БЕТА" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarningBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel x:Name="HeaderStatsPanel" Orientation="Vertical" VerticalAlignment="Center"
                                Margin="0,0,16,0" HorizontalAlignment="Right">
                        <TextBlock x:Name="HeaderStatsText" Style="{StaticResource HintText}" HorizontalAlignment="Right"
                                   Visibility="Collapsed" Text="↓ 0 КБ/с · ↑ 0 КБ/с" />
                        <TextBlock x:Name="HeaderExitText" Style="{StaticResource HintText}" HorizontalAlignment="Right"
                                   Visibility="Collapsed" ToolTip="Страна и IP, через которые вы выходите в интернет" />
                    </StackPanel>
                    <Button x:Name="ConnectButton" Content="Подключить" Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0" Click="OnHeaderConnectClick"
                            ToolTip="Подключиться к лучшему проверенному узлу или отключиться" />
                    <Button x:Name="CancelButton" Content="Отмена" Style="{StaticResource SmallButton}"
                            Visibility="Collapsed" Click="OnCancelClick" ToolTip="Прервать текущую операцию" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1">

            <!-- ПОДКЛЮЧЕНИЕ: способы обхода и туннель -->
            <TabItem x:Name="ConnectionTab" Header="Подключение" Style="{StaticResource AppTabItem}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,10,16,0">
                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                   Text="Способы обойти блокировки: zapret, свой обход DPI, видео YouTube и Telegram через узел, а также режим туннеля. Зелёная заливка — главное действие, зелёный контур — важный следующий шаг." />
                    </Border>
                    <TabControl x:Name="ConnectionTabs">
            <TabItem x:Name="ZapretTab" Header="Обход блокировок" Style="{StaticResource AppTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,12,16,16">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Обход DPI (zapret)" />
                        <TextBlock x:Name="ZapretStatusText" Style="{StaticResource HintText}" TextWrapping="Wrap" Text="Проверка…" />
                        <TextBlock x:Name="ZapretActiveText" Style="{StaticResource HintText}" Margin="0,4,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="BypassButton" Content="Включить обход" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                    Click="OnBypassButtonClick" ToolTip="Включить или остановить обход DPI (zapret)" />
                            <Button Content="Скачать / обновить zapret" Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="OnZapretInstallClick" />
                            <Button Content="Подобрать под провайдера" Style="{StaticResource AccentSmallButton}" Click="OnZapretTuneClick"
                                    ToolTip="Перебрать все режимы zapret (несколько минут); проверка идёт только по YouTube, Telegram и Discord" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Стратегия" Margin="0,20,0,6" />
                        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                            <UniformGrid x:Name="ZapretPresetPanel" Columns="3" />
                        </ScrollViewer>
                        <CheckBox x:Name="ZapretGameModeCheck" Content="Игровой режим: обход UDP (QUIC, STUN, WireGuard)" Style="{StaticResource AppCheckBox}" Margin="0,8,0,0"
                                  Checked="OnZapretGameModeChanged" Unchecked="OnZapretGameModeChanged"
                                  ToolTip="Добавляет обработку UDP: QUIC (видео YouTube), голос Discord/Telegram, WireGuard. Если видео зависает — включите этот режим" />
                        <CheckBox x:Name="ZapretAutoStartCheck" Content="Запускать обход DPI при старте приложения" Style="{StaticResource AppCheckBox}" Margin="0,4,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Проверить напрямую" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                                    Click="OnZapretProbeClick"
                                    ToolTip="Проверить YouTube, t.me и Discord без прокси — с текущей стратегией zapret" />
                            <Button Content="Виджет" Style="{StaticResource SmallButton}"
                                    Click="OnZapretWidgetClick"
                                    ToolTip="Маленькое окно поверх всех: включение обхода, автоподбор и игровой режим" />
                        </StackPanel>
                        <TextBlock x:Name="ZapretTuneText" Style="{StaticResource HintText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <StackPanel x:Name="ZapretResultsPanel" Margin="0,6,0,0" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Как это работает" Margin="0,24,0,8" />
                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                   Text="zapret разрезает и подменяет TLS-пакеты на уровне Windows (WinDivert), чтобы DPI не увидел домен. Прокси-узел не нужен. Требуются права администратора: приложение предложит перезапуск с UAC.&#10;&#10;«Подобрать под провайдера» перебирает все режимы winws: fake, fakedsplit, fakeddisorder, split2, disorder, multisplit, multidisorder, hostfakesplit, ipfrag, synack, syndata, rst, rstack, tamper, hopbyhop, destopt, wssize и их комбинации. Проверяются YouTube (страница и сервер видео), t.me и Discord, причём десинк применяется только к этим доменам — посторонний трафик не затрагивается. Рабочие для YouTube стратегии отмечаются зелёным, а приложение запоминает их и в следующий раз проверяет первыми. Полный перебор занимает несколько минут, прогресс виден в строке состояния и журнале.&#10;&#10;Если страница YouTube открывается, а видео не грузится — видео-серверы блокируются отдельно. Разрезание TLS может не помочь: тогда для видео нужен прокси-узел или своя подписка.&#10;&#10;При подключении к прокси-узлу обход DPI останавливается автоматически, чтобы два обхода не мешали друг другу.&#10;&#10;Файлы winws и WinDivert хранятся в папке zapret рядом с программой — релиз можно переносить на другой компьютер целиком. Если каталог защищён от записи (например, Program Files), используется %LOCALAPPDATA%\VieNLink\zapret." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
                <TabItem x:Name="DesyncTab" Header="Свой обход DPI" Style="{StaticResource AppTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,12,16,16">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Собственный обход DPI (WinDivert)" />
                            <TextBlock x:Name="DesyncStatusText" Style="{StaticResource HintText}" TextWrapping="Wrap" Text="Проверка…" />
                            <TextBlock x:Name="DesyncActiveText" Style="{StaticResource HintText}" Margin="0,4,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="DesyncToggleButton" Content="Включить обход" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                        Click="OnDesyncToggleClick" ToolTip="Включить или остановить собственный обход DPI" />
                                <Button x:Name="DesyncInstallButton" Content="Установить WinDivert" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                                        Click="OnDesyncInstallClick" ToolTip="Скачать WinDivert (DLL + драйвер) в папку desync" />
                                <Button x:Name="DesyncTuneButton" Content="Подобрать стратегию" Style="{StaticResource AccentSmallButton}"
                                        Click="OnDesyncTuneClick" ToolTip="Перебрать стратегии и проверить YouTube и Telegram" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="Стратегия" Margin="0,20,0,6" />
                            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                <UniformGrid x:Name="DesyncStrategyPanel" Columns="2" />
                            </ScrollViewer>
                            <CheckBox x:Name="DesyncAutoStartCheck" Content="Запускать свой обход DPI при старте приложения"
                                      Style="{StaticResource AppCheckBox}" Margin="0,8,0,0"
                                      Checked="OnDesyncAutoStartChanged" Unchecked="OnDesyncAutoStartChanged" />
                            <CheckBox x:Name="DesyncBlockQuicCheck" Content="Блокировать QUIC (UDP/443), чтобы видео шло по TCP"
                                      Style="{StaticResource AppCheckBox}" Margin="0,4,0,0"
                                      Checked="OnDesyncBlockQuicChanged" Unchecked="OnDesyncBlockQuicChanged"
                                      ToolTip="YouTube-видео часто идёт по QUIC; блокировка заставляет браузер перейти на TCP, который умеет обходить движок" />

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="DesyncProbeButton" Content="Проверить напрямую" Style="{StaticResource SmallButton}"
                                        Click="OnDesyncProbeClick"
                                        ToolTip="Проверить YouTube и t.me без прокси — через текущий движок обхода" />
                            </StackPanel>
                            <TextBlock x:Name="DesyncTuneText" Style="{StaticResource HintText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <StackPanel x:Name="DesyncResultsPanel" Margin="0,6,0,0" />

                            <TextBlock Style="{StaticResource SectionTitle}" Text="Как это работает" Margin="0,24,0,8" />
                            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                       Text="Это собственный движок VieNLink: без winws.exe и без zapret. Он перехватывает исходящий TLS на порт 443, режет ClientHello на TCP-сегменты, меняет их порядок или подмешивает фейковый ClientHello с безобидным SNI. Современные Chrome и Windows присылают ClientHello больше одного TCP-сегмента — движок находит SNI в полезной нагрузке и режет по его границам, а не по фиксированным позициям. Для QUIC отправляется поддельный Initial на google. Прокси-узел не нужен.&#10;&#10;Нужны права администратора и драйвер WinDivert: приложение предложит перезапуск с UAC. Локальные и приватные адреса не трогаются. При подключении к прокси-узлу или включении zapret движок останавливается автоматически.&#10;&#10;«Подобрать стратегию» проверяет страницу YouTube, видео и t.me через каждую стратегию и выбирает рабочую. Страница YouTube и Discord открываются (TTL 128/64), Cloudflare не ломается. Видео YouTube у этого провайдера отдаётся с локального видео-узла Google (GGC) и блокируется по IP: TCP открывается, TLS не проходит ни с одной стратегией. Подробности и обход видео — в подвкладке «Видео YouTube». TLS-фрагментация sing-box (tls.fragment) настраивается в «Инструменты → Настройки» и работает только через узел." />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                        <TabItem x:Name="VideoDevTab" Header="Видео YouTube" Style="{StaticResource AppTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,12,16,24" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Видео YouTube" />
                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                   Text="Домашний и мобильный провайдеры режут видео-узел YouTube по IP: TCP до него открывается, а TLS не проходит. Это проверено на всех 29 режимах zapret, на domain fronting, подмене IP и DNS, IPv6 — ни один способ не помогает. Видео работает только через прокси-узел: кнопка ниже направит через него только YouTube, остальные сайты пойдут напрямую." />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="VideoNodeButton" Content="Видео через узел" Style="{StaticResource PrimaryButton}"
                                    Click="OnVideoViaNodeClick"
                                    ToolTip="Направить только YouTube через лучший проверенный узел, остальные сайты — напрямую. Нужен хотя бы один рабочий узел" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Если узлов нет: «Инструменты → Источники» → «Обновить списки», затем «Инструменты → Узлы» → «Проверить всё». Вернуть всё как было: «Инструменты → Туннель → Всё через узел»." />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Что уже проверено" Margin="0,20,0,6" />
                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                   Text="• 29 режимов zapret: fake, split, multidisorder, ipfrag1/2, hopbyhop, destopt, synack, syndata, rst, rstack, tamper, wssize — видео-узел не отдаёт ни байта.&#10;• Domain fronting: тот же IP с чужим SNI — TLS всё равно обрывается.&#10;• Другие узлы Google — отвечают 404, ссылка привязана к локальному узлу.&#10;• Подмена DNS (9.9.9.9, DoH) — помогает открыть страницу на мобильной сети, но видео не открывает.&#10;• IPv6 — ни домашний роутер, ни мобильная сеть его не выдают." />
                    </StackPanel>
                </ScrollViewer>
                        </TabItem>
            <TabItem x:Name="TelegramTab" Header="Telegram" Style="{StaticResource AppTabItem}">
                <DockPanel Margin="16,12,16,16">
                    <Border DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Сбор:" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource MutedStrongBrush}" />
                                <Button Content="Собрать из каналов" Style="{StaticResource AccentSmallButton}" Margin="0,0,8,0" Click="OnMtProtoRefreshClick" />
                                <Button Content="Добавить вручную" Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="OnMtProtoAddManuallyClick" />
                                <Button Content="Через RSS" Style="{StaticResource SmallButton}" Click="OnMtProtoRssClick"
                                        ToolTip="Прочитать каналы через публичные RSS-зеркала: t.me не нужен" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Прокси:" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource MutedStrongBrush}" />
                                <Button Content="Проверить соединение" Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="OnMtProtoTestClick"
                                        ToolTip="Проверить TCP-соединение со всеми прокси на открытой подвкладке" />
                                <Button Content="Открыть в Telegram" Style="{StaticResource AccentSmallButton}" Click="OnMtProtoOpenClick" />
                                <Button Content="Telegram через узел" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="OnTelegramViaNodeClick"
                                        ToolTip="Направить через прокси-узел только Telegram, остальные сайты — напрямую" />
                            </StackPanel>
                            <TextBlock x:Name="MtProtoSummary" Style="{StaticResource HintText}" Margin="0,8,0,0" />
                            <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                                       Text="MTProto-прокси работают только внутри Telegram: браузер через них пустить нельзя, это протокол самого мессенджера. «Проверить соединение» перепроверяет открытую подвкладку, выбранную строку можно проверить из контекстного меню. Нерабочие хранятся 14 дней. Если t.me недоступен — жмите «Через RSS»: приложение прочитает канал через tg.i-c-a.su и RSSHub-зеркала (при ответе 429 подождите минуту)." />
                        </StackPanel>
                    </Border>

                    <TabControl x:Name="MtProtoTabs">
                        <TabItem x:Name="MtProtoWorkingTab" Header="Список" Style="{StaticResource AppTabItem}">
                            <Grid>
                                <DataGrid x:Name="MtProtoGrid" Style="{StaticResource AppDataGrid}" MouseDoubleClick="OnMtProtoDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Сервер" Binding="{Binding Server}" Width="*" MinWidth="160" />
                                        <DataGridTextColumn Header="Порт" Binding="{Binding Port}" Width="70" />
                                        <DataGridTextColumn Header="Задержка" Binding="{Binding DelayLabel}" Width="90" SortMemberPath="PingSortValue" />
                                        <DataGridTextColumn Header="Секрет" Binding="{Binding SecretShort}" Width="110" />
                                        <DataGridTextColumn Header="Проверен" Binding="{Binding CheckedAtLabel}" Width="110" />
                                        <DataGridTextColumn Header="Источник" Binding="{Binding SourceName}" Width="200" />
                                    </DataGrid.Columns>
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Проверить соединение" Click="OnMtProtoTestSelectedClick" />
                                            <MenuItem Header="Открыть в Telegram" Click="OnMtProtoOpenClick" />
                                            <Separator />
                                            <MenuItem Header="Копировать ссылку" Click="OnMtProtoCopyClick" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                </DataGrid>

                                <StackPanel x:Name="MtProtoEmpty" VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="Collapsed" IsHitTestVisible="False">
                                    <TextBlock Text="MTProto-прокси не собраны" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedStrongBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Включите канал Telegram на вкладке «Инструменты → Источники» и нажмите «Собрать из каналов»"
                                               Style="{StaticResource HintText}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="MtProtoDeadTab" Header="Нерабочие" Style="{StaticResource AppTabItem}">
                            <DockPanel>
                                <TextBlock x:Name="MtProtoDeadSummary" DockPanel.Dock="Top" Style="{StaticResource HintText}" Margin="8,8,8,0"
                                           Text="Сюда попадают прокси, не ответившие при проверке. Хранятся 14 дней, затем удаляются." />
                                <Grid>
                                    <DataGrid x:Name="MtProtoDeadGrid" Style="{StaticResource AppDataGrid}" MouseDoubleClick="OnMtProtoDoubleClick">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Сервер" Binding="{Binding Server}" Width="*" MinWidth="160" />
                                            <DataGridTextColumn Header="Порт" Binding="{Binding Port}" Width="70" />
                                            <DataGridTextColumn Header="Секрет" Binding="{Binding SecretShort}" Width="110" />
                                            <DataGridTextColumn Header="Стал недоступен" Binding="{Binding DeadAtLabel}" Width="120" />
                                            <DataGridTextColumn Header="Осталось" Binding="{Binding DeadExpiresLabel}" Width="90" />
                                            <DataGridTextColumn Header="Источник" Binding="{Binding SourceName}" Width="200" />
                                        </DataGrid.Columns>
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Проверить соединение" Click="OnMtProtoTestSelectedClick" />
                                                <MenuItem Header="Открыть в Telegram" Click="OnMtProtoOpenClick" />
                                                <Separator />
                                                <MenuItem Header="Копировать ссылку" Click="OnMtProtoCopyClick" />
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                    </DataGrid>

                                    <StackPanel x:Name="MtProtoDeadEmpty" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Visibility="Collapsed" IsHitTestVisible="False">
                                        <TextBlock Text="Нерабочих прокси нет" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MutedStrongBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Не ответившие при проверке прокси попадут сюда и будут храниться 14 дней"
                                                   Style="{StaticResource HintText}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="TunTab" Header="Туннель" Style="{StaticResource AppTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,12,16,24" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Туннель и маршрутизация" />
                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="Как заворачивать трафик: системный прокси Windows или TUN на весь компьютер. Здесь же — какие сайты и приложения идут через узел." />
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Туннелирование" Margin="0,20,0,8" />
                        <RadioButton x:Name="SystemProxyModeRadio" GroupName="Tunnel" Style="{StaticResource AppRadioButton}" Margin="0,4"
                                     Content="Системный прокси Windows — браузеры и приложения, уважающие настройки"
                                     Checked="OnRoutingChanged" />
                        <RadioButton x:Name="TunModeRadio" GroupName="Tunnel" Style="{StaticResource AppRadioButton}" Margin="0,4"
                                     Content="TUN — весь трафик компьютера (нужны права администратора)"
                                     Checked="OnRoutingChanged" />
                        <CheckBox x:Name="StrictRouteCheck" Content="Строгая маршрутизация TUN (не давать обходить туннель)"
                                  Style="{StaticResource AppCheckBox}" Margin="24,6,0,4" Checked="OnRoutingChanged" Unchecked="OnRoutingChanged" />
