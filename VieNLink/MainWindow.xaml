                                  ToolTip="Отдельное ядро sing-box на своих портах: не трогает системный прокси и TUN, поэтому не мешает текущему подключению. В простое — крупные партии, при работе — частые маленькие" />
                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Считать компьютер занятым после, мин" VerticalAlignment="Center" Foreground="{DynamicResource TextSoftBrush}" />
                            <TextBox Grid.Column="1" x:Name="IdleMinutesBox" Style="{StaticResource AppTextBox}" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Узлов за проход в простое" VerticalAlignment="Center" Foreground="{DynamicResource TextSoftBrush}" />
                            <TextBox Grid.Column="1" x:Name="IdleBatchBox" Style="{StaticResource AppTextBox}" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Интервал фоновой проверки, мин" VerticalAlignment="Center" Foreground="{DynamicResource TextSoftBrush}" />
