<Window x:Class="VieNLink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VieNLink (бета) — свободные узлы"
        Icon="pack://application:,,,/Assets/VieNLink.ico"
        Height="820" Width="1240"
        MinHeight="620" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шапка: состояние и главные действия -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource TableGridLineBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Логотип приложения в шапке -->
                <Image Grid.Column="0" x:Name="HeaderLogo"
                       Source="pack://application:,,,/Assets/VieNLink.png"
                       Width="58" Height="58" Margin="0,0,14,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       ToolTip="VieNLink — клиент свободных узлов" />

                <Border Grid.Column="1" Background="{DynamicResource HeaderStatusBackgroundBrush}"
                        BorderBrush="{DynamicResource HeaderInfoBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="12,7" MinHeight="84" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" x:Name="StatusDot" Width="10" Height="10" Fill="{DynamicResource MutedBrush}" VerticalAlignment="Top" Margin="0,7,10,0" />
                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="StatusText" Text="Отключено" FontSize="17" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextStrongBrush}" VerticalAlignment="Center" />
                                <Border Background="{DynamicResource WarningSurfaceBrush}" CornerRadius="9" Padding="8,2"
                                        Margin="10,0,0,0" VerticalAlignment="Center"
                                        ToolTip="Бета-версия: основные режимы проверены, но возможны сбои">
                                    <TextBlock Text="БЕТА" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WarningBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="HeaderNodesText" Style="{StaticResource HintText}"
                                       Text="Загруженные узлы: 0 · YouTube 0 · Discord 0 · Telegram 0 · Универсальных 0"
                                       ToolTip="Уже проверенные и рассортированные узлы по сервисам" />
                            <TextBlock x:Name="StatusDetail" Style="{StaticResource HintText}" Text="Списки узлов ещё не загружены" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                    <Border x:Name="HeaderConnectionPanel" Background="{DynamicResource HeaderInfoBackgroundBrush}"
                            BorderBrush="{DynamicResource HeaderInfoBorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="12,7" Margin="0,0,12,0"
                            VerticalAlignment="Center" Visibility="Collapsed">
                        <DockPanel>
                            <Border x:Name="HeaderConnectionAccent" DockPanel.Dock="Left" Width="3" CornerRadius="2"
                                    Margin="0,0,10,0" Background="{DynamicResource AccentBrush}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" MaxWidth="320">
                                    <TextBlock x:Name="HeaderConnectionText" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextStrongBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="HeaderConnectionQualityText" Style="{StaticResource HintText}"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="HeaderConnectionStatsText" Style="{StaticResource HintText}"
                                               HorizontalAlignment="Right" />
                                    <TextBlock x:Name="HeaderConnectionRatingText" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="HeaderStatsText" Visibility="Collapsed" />
                                <TextBlock x:Name="HeaderExitText" Visibility="Collapsed" />
                            </Grid>
                        </DockPanel>
                    </Border>
                    <Button x:Name="CancelButton" Style="{StaticResource WarningButton}"
                            Margin="0,0,8,0" Visibility="Collapsed" Click="OnCancelClick"
                            ToolTip="Прервать текущую операцию">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M12,2C17.5,2 22,6.5 22,12C22,17.5 17.5,22 12,22C6.5,22 2,17.5 2,12C2,6.5 6.5,2 12,2M12,4C7.58,4 4,7.58 4,12C4,16.42 7.58,20 12,20C16.42,20 20,16.42 20,12C20,7.58 16.42,4 12,4M16.24,7.76L17.66,9.17L13.41,13.41L17.66,17.66L16.24,19.07L12,14.83L7.76,19.07L6.34,17.66L10.59,13.41L6.34,9.17L7.76,7.76L12,12L16.24,7.76Z" />
                            <TextBlock Text="Отменить" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="HeaderDisconnectButton" Style="{StaticResource DangerButton}"
                            Visibility="Collapsed" Click="OnDisconnectClick"
                            ToolTip="Отключить все активные подключения">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M16.56,5.44L15.11,6.89C16.84,7.94 18,9.83 18,12A6,6 0 0,1 12,18A6,6 0 0,1 6,12C6,9.83 7.16,7.94 8.88,6.88L7.44,5.44C5.36,6.88 4,9.28 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12C20,9.28 18.64,6.88 16.56,5.44M13,3H11V13H13V3Z" />
                            <TextBlock Text="Отключить" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" SelectionChanged="OnMainTabsSelectionChanged">

            <!-- ПОДКЛЮЧЕНИЕ: быстрое подключение и Telegram -->
            <TabItem x:Name="ConnectionTab" Style="{StaticResource AppTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource TabIcon}"
                              Data="M3.9,12C3.9,10.29 5.29,8.9 7,8.9H11V7H7A5,5 0 0,0 2,12A5,5 0 0,0 7,17H11V15.1H7C5.29,15.1 3.9,13.71 3.9,12M8,13H16V11H8V13M17,7H13V8.9H17C18.71,8.9 20.1,10.29 20.1,12C20.1,13.71 18.71,15.1 17,15.1H13V17H17A5,5 0 0,0 22,12A5,5 0 0,0 17,7Z" />
                        <TextBlock Text="Подключение" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="16,12,16,4">
                        <Button Style="{StaticResource YouTubeSmallButton}" Margin="0,0,8,8" Tag="youtube"
                                Click="OnQuickServiceClick" ToolTip="Подключиться через лучший узел с доступом к YouTube">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18" Margin="0,0,7,0">
                                    <Canvas Width="24" Height="24">
                                        <Rectangle Canvas.Left="1" Canvas.Top="5" Width="22" Height="14"
                                                   RadiusX="4" RadiusY="4" Fill="{DynamicResource YouTubeBrush}" />
                                        <Path Fill="#FFFFFFFF" Data="M 9.5,8.5 L 16.5,12 L 9.5,15.5 Z" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="YouTube" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource DiscordSmallButton}" Margin="0,0,8,8" Tag="discord"
                                Click="OnQuickServiceClick" ToolTip="Подключиться через лучший узел с доступом к Discord">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18" Margin="0,0,7,0">
                                    <Path Fill="{DynamicResource DiscordBrush}" Stretch="Uniform"
                                          Data="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z" />
                                </Viewbox>
                                <TextBlock Text="Discord" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource UniversalSmallButton}" Margin="0,0,8,8" Tag="universal"
                                Click="OnQuickServiceClick" ToolTip="Подключиться через лучший узел с универсальным доступом (Cloudflare)">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18" Margin="0,0,7,0">
                                    <Path Fill="{DynamicResource UniversalBrush}" Stretch="Uniform"
                                          Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" />
                                </Viewbox>
                                <TextBlock Text="Универсальный" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource TelegramSmallButton}" Margin="0,0,8,8" Tag="telegram"
                                Click="OnQuickServiceClick" ToolTip="Подключиться через лучший узел с доступом к Telegram">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18" Margin="0,0,7,0">
                                    <Grid Width="24" Height="24">
                                        <Ellipse Width="24" Height="24" Fill="#FFFFFFFF" />
                                        <Path Fill="{DynamicResource TelegramBrush}"
                                              Data="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z" />
                                    </Grid>
                                </Viewbox>
                                <TextBlock Text="Telegram" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <RadioButton x:Name="TelegramTab" Content="Telegram MTProtoProxies"
                                     Style="{StaticResource TelegramTabRadio}"
                                     Checked="OnTelegramTabChecked" Unchecked="OnTelegramTabUnchecked"
                                     ToolTip="Открыть страницу Telegram MTProtoProxies: MTProto-прокси и подключение через узел" />
                    </WrapPanel>
                    <Grid>
                        <ScrollViewer x:Name="QuickConnectPage" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16,4,16,16">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Быстрое подключение" />
                                <TextBlock Style="{StaticResource InstructionText}"
                                           Text="Узел выбирается автоматически из уже проверенных: чем больше заблокированных доменов он открывает, тем выше. Для Telegram откройте «Telegram MTProtoProxies» — там MTProto-прокси и отдельное подключение только для Telegram." />
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Как это работает" Margin="0,20,0,8" />
                                <Border Style="{StaticResource InstructionCard}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="КРАТКО" Style="{StaticResource InstructionLabel}" Margin="0,0,0,4" />
                                        <TextBlock Style="{StaticResource InstructionSummary}">
                                            <Run Text="Нажмите кнопку сервиса — VieNLink сам выберет " />
                                            <Run Text="проверенный узел" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" />
                                            <Run Text=" с доступом к нему и подключится." />
                                        </TextBlock>
                                        <TextBlock Text="ПОДРОБНЕЕ" Style="{StaticResource InstructionLabel}" />
                                        <TextBlock Style="{StaticResource InstructionText}"
                                                   Text="Отдельный узел для каждого сервиса искать не нужно. После подключения в шапке появятся страна, задержка и скорость; при сбое узел заменится автоматически, если включено автопереключение." />
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Виджет и главное окно" Margin="0,20,0,8" />
                                <Border Style="{StaticResource InstructionCard}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="КРАТКО" Style="{StaticResource InstructionLabel}" Margin="0,0,0,4" />
                                        <TextBlock Style="{StaticResource InstructionSummary}">
                                            <Run Text="Окно можно " />
                                            <Run Text="свернуть, развернуть и изменить в размере" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" />
                                            <Run Text=", а окно и виджет " />
                                            <Run Text="запоминают своё место" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" />
                                            <Run Text=". Кнопка «Виджет» в ряду вкладок выделена цветом." />
                                        </TextBlock>
                                        <TextBlock Text="ПОДРОБНЕЕ" Style="{StaticResource InstructionLabel}" />
                                        <TextBlock Style="{StaticResource InstructionText}"
                                                   Text="Перетащите главное окно за заголовок — при следующем запуске оно откроется там же. Плавающий виджет вызывается цветной кнопкой «Виджет»; его можно перетащить в удобное место, а кнопкой «▾» свернуть в компактную строку. Место и свёрнутое состояние тоже сохраняются." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <DockPanel x:Name="TelegramPage" Visibility="Collapsed" Margin="16,4,16,16">
                    <Border DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Прокси:" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource MutedStrongBrush}" />
                                <Button Content="Проверить соединение" Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="OnMtProtoTestClick"
                                        ToolTip="Проверить TCP-соединение со всеми прокси на открытой подвкладке" />
                                <Button Content="Открыть в Telegram" Style="{StaticResource AccentSmallButton}" Click="OnMtProtoOpenClick" />
                            </StackPanel>
                            <TextBlock x:Name="MtProtoSummary" Style="{StaticResource HintText}" Margin="0,8,0,0" />
                            <TextBlock Style="{StaticResource InstructionText}" Margin="0,8,0,0"
                                       Text="MTProto-прокси работают только внутри Telegram: браузер через них пустить нельзя, это протокол самого мессенджера. Каналы читаются автоматически через RSS-зеркала, рабочие прокси проверяются каждые 10 минут, нерабочие — изредка. «Проверить соединение» запускает ручную проверку открытой подвкладки, нерабочие удаляются через 24 часа." />
                        </StackPanel>
                    </Border>

                    <TabControl x:Name="MtProtoTabs">
                        <TabItem x:Name="MtProtoWorkingTab" Header="Список" Style="{StaticResource AppTabItem}">
                            <Grid>
                                <DataGrid x:Name="MtProtoGrid" Style="{StaticResource AppDataGrid}" MouseDoubleClick="OnMtProtoDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Сервер" Binding="{Binding Server}" Width="*" MinWidth="160" />
                                        <DataGridTextColumn Header="Порт" Binding="{Binding Port}" Width="70" />
                                        <DataGridTextColumn Header="Задержка" Binding="{Binding DelayLabel}" Width="90" SortMemberPath="PingSortValue" />
                                        <DataGridTextColumn Header="Секрет" Binding="{Binding SecretShort}" Width="110" />
                                        <DataGridTextColumn Header="Проверен" Binding="{Binding CheckedAtLabel}" Width="110" />
                                        <DataGridTextColumn Header="Источник" Binding="{Binding SourceName}" Width="200" />
                                    </DataGrid.Columns>
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Проверить соединение" Click="OnMtProtoTestSelectedClick" />
                                            <MenuItem Header="Открыть в Telegram" Click="OnMtProtoOpenClick" />
                                            <Separator />
                                            <MenuItem Header="Копировать ссылку" Click="OnMtProtoCopyClick" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                </DataGrid>

                                <StackPanel x:Name="MtProtoEmpty" VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="Collapsed" IsHitTestVisible="False">
                                    <TextBlock Text="MTProto-прокси не собраны" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedStrongBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Включите канал Telegram на вкладке «Инструменты → Источники» и нажмите «Собрать из каналов»"
                                               Style="{StaticResource HintText}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="MtProtoDeadTab" Header="Нерабочие" Style="{StaticResource AppTabItem}">
                            <DockPanel>
                                <TextBlock x:Name="MtProtoDeadSummary" DockPanel.Dock="Top" Style="{StaticResource HintText}" Margin="8,8,8,0"
                                           Text="Сюда попадают прокси, не ответившие при проверке. Удаляются через 24 часа, иногда проверяются на оживание." />
                                <Grid>
                                    <DataGrid x:Name="MtProtoDeadGrid" Style="{StaticResource AppDataGrid}" MouseDoubleClick="OnMtProtoDoubleClick">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Сервер" Binding="{Binding Server}" Width="*" MinWidth="160" />
                                            <DataGridTextColumn Header="Порт" Binding="{Binding Port}" Width="70" />
                                            <DataGridTextColumn Header="Секрет" Binding="{Binding SecretShort}" Width="110" />
                                            <DataGridTextColumn Header="Стал недоступен" Binding="{Binding DeadAtLabel}" Width="120" />
                                            <DataGridTextColumn Header="Осталось" Binding="{Binding DeadExpiresLabel}" Width="90" />
                                            <DataGridTextColumn Header="Источник" Binding="{Binding SourceName}" Width="200" />
                                        </DataGrid.Columns>
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Проверить соединение" Click="OnMtProtoTestSelectedClick" />
                                                <MenuItem Header="Открыть в Telegram" Click="OnMtProtoOpenClick" />
                                                <Separator />
                                                <MenuItem Header="Копировать ссылку" Click="OnMtProtoCopyClick" />
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                    </DataGrid>

                                    <StackPanel x:Name="MtProtoDeadEmpty" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Visibility="Collapsed" IsHitTestVisible="False">
                                        <TextBlock Text="Нерабочих прокси нет" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MutedStrongBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Не ответившие при проверке прокси попадут сюда и будут храниться 24 часа"
                                                   Style="{StaticResource HintText}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Grid>
        </DockPanel>
    </TabItem>

            <!-- ОБХОД БЛОКИРОВОК: zapret, свой обход DPI и TUN-обход -->
            <TabItem x:Name="BypassTab" Style="{StaticResource AppTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource TabIcon}"
                              Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M10,17L6,13L7.41,11.59L10,14.17L16.59,7.58L18,9L10,17Z" />
                        <TextBlock Text="Обход блокировок" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,10,16,0">
