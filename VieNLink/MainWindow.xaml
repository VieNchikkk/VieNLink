                            <Button x:Name="TunBypassProbeButton" Content="Проверить напрямую" Style="{StaticResource SmallButton}"
                                    Click="OnTunBypassProbeClick"
                                    ToolTip="Проверить Cloudflare, YouTube и t.me через TUN-обход (запрос идёт отдельным процессом)" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Стратегия фрагментации" Margin="0,20,0,6" />
                        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                            <UniformGrid x:Name="TunBypassStrategyPanel" Columns="2" />
                        </ScrollViewer>
                        <CheckBox x:Name="TunBypassBlockQuicCheck" Content="Блокировать QUIC (UDP/443), чтобы видео шло по TCP"
                                  Style="{StaticResource AppCheckBox}" Margin="0,8,0,0"
                                  Checked="OnTunBypassBlockQuicChanged" Unchecked="OnTunBypassBlockQuicChanged"
                                  ToolTip="QUIC нельзя разрезать в пользовательском TCP-форвардере. Блокировка заставляет браузер перейти на TCP" />
                        <CheckBox x:Name="TunBypassAutoStartCheck" Content="Запускать TUN-обход при старте приложения"
                                  Style="{StaticResource AppCheckBox}" Margin="0,4,0,0"
                                  Checked="OnTunBypassAutoStartChanged" Unchecked="OnTunBypassAutoStartChanged" />
                        <TextBlock x:Name="TunBypassTuneText" Style="{StaticResource HintText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <StackPanel x:Name="TunBypassResultsPanel" Margin="0,6,0,0" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Как это работает" Margin="0,24,0,8" />
                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                   Text="Обход без прокси-узла и без WinDivert. sing-box поднимает TUN-адаптер VieNLink-Bypass и отправляет TCP в локальный SOCKS5-форвардер VieNLink. Форвардер открывает прямой канал до сайта и режет TLS ClientHello на TCP-сегменты или меняет их порядок — DPI не собирает SNI. QUIC блокируется, чтобы браузер перешёл на TCP. Работает по IPv4; IPv6 пока идёт напрямую.&#10;&#10;Нужны права администратора и wintun.dll: приложение предложит перезапуск с UAC. Трафик самого VieNLink.exe идёт напрямую, иначе форвардер замкнулся бы сам на себя. Это отдельный режим: при подключении к узлу, включении zapret или «Своего обхода DPI» TUN-обход останавливается.&#10;&#10;«Автоподключение» по очереди запускает TUN-обход с каждой стратегией, проверяет Cloudflare, YouTube и t.me через отдельный процесс curl.exe и выбирает лучшую (сначала те, что открывают YouTube и Telegram, затем быстрейшие). Стратегии — разные позиции разреза: после первого символа SNI, перед SNI, в середине домена, после TLS-заголовка, после 1-го байта и мультиразрез. На разных провайдерах работают разные.&#10;&#10;Если Cloudflare открывается, а YouTube или t.me — нет, значит ТСПУ блокирует их по IP/протоколу, а не по SNI: для них нужен прокси-узел или zapret/WinDivert." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
