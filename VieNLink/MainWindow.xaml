                        <CheckBox x:Name="AutoDiscoverCheck" Content="Искать новые источники автоматически (GitHub и публичные сайты)" Style="{StaticResource AppCheckBox}" Margin="0,4" />
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Искать новые не чаще, чем раз в, ч" VerticalAlignment="Center" Foreground="{DynamicResource TextSoftBrush}" />
                            <TextBox Grid.Column="1" x:Name="AutoDiscoverHoursBox" Style="{StaticResource AppTextBox}" />
                        </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Сохранить настройки" Style="{StaticResource PrimaryButton}" Click="OnSaveSettingsClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Добавить подписку или источник" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NewSourceName" Style="{StaticResource AppTextBox}" Margin="0,0,8,0" ToolTip="Название (необязательно)" />
                                <TextBox Grid.Column="1" x:Name="NewSourceUrl" Style="{StaticResource AppTextBox}" Margin="0,0,8,0"
                                         ToolTip="Ссылка на подписку (v2rayN/Xray/Clash), raw-список или канал https://t.me/s/имя" />
                                <Button Grid.Column="2" Content="Добавить" Style="{StaticResource BaseButton}" Click="OnAddSourceClick" />
                            </Grid>
                            <CheckBox x:Name="NewSourceMineCheck" IsChecked="True" Margin="0,8,0,0"
                                      Style="{StaticResource AppCheckBox}"
                                      Content="Это моя подписка (платная) — держать отдельно от публичных" />
                            <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                                       Text="Можно вставить ссылку подписки от провайдера (Happ, v2rayN и т.п.) или ссылки на серверы (vless://, vmess://, trojan://, ss://, hysteria2://) — по одной в строке. Формат подписки определяется автоматически. Если провайдер отдаёт остаток трафика, он появится в колонке «Трафик»." />
                        </StackPanel>
                    </Border>

                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Найти новые источники" Style="{StaticResource AccentSmallButton}" Margin="0,0,8,0" Click="OnDiscoverClick" />
                            <Button Content="Обновить выбранный" Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="OnRefreshSourceClick" />
                            <Button Content="Проверить все источники" Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="OnCheckSourcesClick" />
                            <Button Content="Удалить выбранный" Style="{StaticResource SmallButton}" Click="OnRemoveSourceClick" />
                        </StackPanel>
                    </DockPanel>

                    <ListView x:Name="SourcesList" Background="Transparent" BorderThickness="0"
                              ItemContainerStyle="{StaticResource AppListViewItem}">
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource PanelBrush}" Padding="8,5" Margin="0,8,0,4" CornerRadius="6">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{DynamicResource TextStrongBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Вкл" Width="50">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource AppCheckBox}" IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                      Checked="OnSourceToggled" Unchecked="OnSourceToggled" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Моя" Width="50">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource AppCheckBox}" IsChecked="{Binding IsMine, UpdateSourceTrigger=PropertyChanged}"
                                                      Checked="OnSourceMineToggled" Unchecked="OnSourceMineToggled" VerticalAlignment="Center"
                                                      ToolTip="Личная подписка: отдельная группа и приоритет при подключении" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Название" Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Адрес" Width="400">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding UrlDisplay}" ToolTip="{Binding Url}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Узлов" Width="70" DisplayMemberBinding="{Binding CountLabel}" />
                                <GridViewColumn Header="Трафик" Width="170" DisplayMemberBinding="{Binding TrafficLabel}" />
                                <GridViewColumn Header="Статус" Width="160">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusLabel}" ToolTip="{Binding StatusLabel}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>


            <!-- ДИАГНОСТИКА -->
            <TabItem Header="Диагностика" Style="{StaticResource AppTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,12,16,16">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Что происходит сейчас" />
                        <Border Background="{DynamicResource PanelBrush}" Padding="14,12" CornerRadius="6">
                            <TextBlock x:Name="DiagnosticsText" Style="{StaticResource HintText}" Text="Не подключено." TextWrapping="Wrap" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Проверить туннель" Style="{StaticResource AccentSmallButton}" Click="OnCheckTunnelClick" Margin="0,0,8,0"
                                    ToolTip="Проверить YouTube и t.me через текущий узел и показать активный/запасной камуфляж" />
                            <Button Content="Очистить лишний кэш" Style="{StaticResource SmallButton}" Click="OnClearCacheClick"
                                    ToolTip="Удалить нерабочие MTProto; узлы и рабочие MTProto останутся" />
                        </StackPanel>
                        <TextBlock x:Name="CacheSummaryText" Style="{StaticResource HintText}" Margin="0,10,0,0" TextWrapping="Wrap" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Тип блокировки" Margin="0,24,0,8" />
                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                   Text="Проверяет TCP и TLS напрямую. Сначала остановите обход DPI — иначе диагностика покажет результат уже с обходом." />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="BlockDiagnoseButton" Content="Проверить YouTube, Discord, Telegram"
                                    Style="{StaticResource AccentSmallButton}" Click="OnBlockDiagnoseClick"
                                    ToolTip="TCP timeout — блокировка по IP; TCP прошёл, TLS оборвался — SNI/TLS-блокировка" />
                        </StackPanel>
                        <TextBlock x:Name="BlockDiagnoseText" Style="{StaticResource HintText}" Margin="0,8,0,0" TextWrapping="Wrap" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Личный зашифрованный канал" Margin="0,24,0,8" />
                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                   Text="Шифрование до сервера уже есть в каждом транспорте (REALITY · Vision, WS · TLS, Hysteria2 · obfs). Но само шифрование не создаёт выход в интернет: нужен сервер, до которого ТСПУ пропускает. Публичные бесплатные узлы для этого ненадёжны — лучше свой VPS или личная подписка. Добавьте её и включите «Подключаться только к моим подпискам» в настройках." />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Добавить свой сервер" Style="{StaticResource AccentSmallButton}" Click="OnAddPersonalServerClick" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Как убедиться, что работает именно автопереключение" Margin="0,24,0,8" />
                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                   Text="1. Подключитесь — выше появятся активный и запасной камуфляж, а также счётчики переключений.&#10;&#10;2. Нажмите «Проверить туннель»: YouTube и t.me должны открыться.&#10;&#10;3. Смоделируйте сбой: заблокируйте IP:порт активного узла в брандмауэре Windows (или дождитесь, когда умрёт бесплатный узел).&#10;&#10;4. Через 45–60 секунд приложение переключится само: в журнале будет «Переключено без перезапуска ядра», а счётчик «тёплых» вырастет.&#10;&#10;5. Для сравнения выключите «Автопереключение при сбое узла» в настройках и повторите: соединение просто упадёт. Это и есть вклад нашей логики, а не сервера." />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Что означают счётчики" Margin="0,24,0,8" />
                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                   Text="• Тёплое переключение — запасной узел уже был в конфиге ядра, поэтому смена произошла без перезапуска и обрыва.&#10;• Полное — пришлось пересобрать конфиг и запустить ядро заново.&#10;• Время в «Последнее» — от обнаружения сбоя до успешной проверки нового узла." />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Что считается маскировкой" Margin="0,24,0,8" />
                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                   Text="REALITY · Vision — TLS-рукопожатие с сертификатом чужого популярного сайта (YouTube/Google, Yandex и др.) и маскировкой под его трафик.&#10;WS · TLS · uTLS — WebSocket поверх TLS с браузерным отпечатком, часто через CDN.&#10;Hysteria2 · obfs — QUIC-подобный транспорт с обфускацией.&#10;TLS — обычный TLS без маскировки под чужой сайт.&#10;«Без TLS» — самый заметный для ТСПУ вариант; фильтр «Только маскированные» его скрывает." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
                        <TabItem x:Name="ConnectionSettingsTab" Header="Настройки" Style="{StaticResource AppTabItem}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="16,12,16,24" MaxWidth="700" HorizontalAlignment="Left">
                                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,12"
                                               Text="Порты, проверка узлов, SNI и TLS-фрагментация. Автообновление источников — в «Инструменты → Источники», правила туннеля — в «Подключение → Туннель»." />
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Порты и проверка" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Локальный порт (HTTP + SOCKS5)" VerticalAlignment="Center" Foreground="{DynamicResource TextSoftBrush}" />
                            <TextBox Grid.Column="1" x:Name="PortBox" Style="{StaticResource AppTextBox}" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Порт Clash API" VerticalAlignment="Center" Foreground="{DynamicResource TextSoftBrush}" />
                            <TextBox Grid.Column="1" x:Name="ApiPortBox" Style="{StaticResource AppTextBox}" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Максимум узлов в конфиге" VerticalAlignment="Center" Foreground="{DynamicResource TextSoftBrush}" />
                            <TextBox Grid.Column="1" x:Name="MaxNodesBox" Style="{StaticResource AppTextBox}" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Всего узлов в списке" VerticalAlignment="Center" Foreground="{DynamicResource TextSoftBrush}"
                                       ToolTip="Жёсткий лимит. Когда список заполнен, новые узлы не добавляются и источники не ищутся, пока накопленные не проверены: нерабочие удаляются и место освобождается" />
                            <TextBox Grid.Column="1" x:Name="MaxTotalNodesBox" Style="{StaticResource AppTextBox}" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Порог задержки, мс" VerticalAlignment="Center" Foreground="{DynamicResource TextSoftBrush}" />
                            <TextBox Grid.Column="1" x:Name="MaxDelayBox" Style="{StaticResource AppTextBox}" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Адрес проверки при подключении" VerticalAlignment="Center" Foreground="{DynamicResource TextSoftBrush}"
                                       ToolTip="Проверка узлов в списке идёт по YouTube и Telegram. Этот адрес используется при подключении, чтобы убедиться, что узел реально работает." />
                            <TextBox Grid.Column="1" x:Name="TestUrlBox" Style="{StaticResource AppTextBox}" />
                        </Grid>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="SNI-маскировка" Margin="0,20,0,6" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SNI-маскировка (необязательно)" VerticalAlignment="Center" Foreground="{DynamicResource TextSoftBrush}"
                                       ToolTip="Подставляется узлам Reality/TLS, у которых нет своего server_name. Примеры: www.microsoft.com, vk.com, yandex.ru" />
                            <TextBox Grid.Column="1" x:Name="SniBox" Style="{StaticResource AppTextBox}" />
                        </Grid>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Быстрый обход DPI (TLS-фрагментация)" Margin="0,20,0,8" />
                        <CheckBox x:Name="TlsFragmentCheck" Content="Фрагментировать TLS-рукопожатие при подключении к узлу (tls.fragment)"
                                  Style="{StaticResource AppCheckBox}" Margin="0,4"
                                  ToolTip="sing-box сам разрежет ClientHello на части: DPI не увидит SNI целиком. Без WinDivert и прав администратора" />
                        <CheckBox x:Name="TlsRecordFragmentCheck" Content="Фрагментировать TLS-записи (record_fragment)"
                                  Style="{StaticResource AppCheckBox}" Margin="0,4"
                                  ToolTip="Дополнительное дробление записей TLS. Помогает, если одного fragment недостаточно" />
                        <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0"
                                   Text="Работает только для трафика через прокси-узел и применяется при следующем подключении. Собственный обход DPI на WinDivert — в «Подключение → Свой обход DPI», TUN-обход — во вкладке «В разработке»." />
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Выбор узла" Margin="0,20,0,8" />
                        <CheckBox x:Name="AutoBestCheck" Content="Автоматически выбирать самый быстрый узел" Style="{StaticResource AppCheckBox}" Margin="0,4" />
                        <CheckBox x:Name="AutoFailoverCheck" Content="Автопереключение при сбое узла (другой камуфляж)" Style="{StaticResource AppCheckBox}" Margin="0,4"
                                  ToolTip="Если узел перестал открывать сайт, приложение само переключится на запасной другого камуфляжа — без перезапуска и диалогов" />
                        <CheckBox x:Name="OnlyVerifiedConnectCheck" Content="Подключаться только к проверенным узлам (с задержкой)" Style="{StaticResource AppCheckBox}" Margin="0,4"
                                  ToolTip="Не пытаться подключаться к непроверенным и мёртвым серверам: только «Рабочие» с задержкой" />
                        <CheckBox x:Name="OnlyMineConnectCheck" Content="Подключаться только к моим подпискам (личный сервер)" Style="{StaticResource AppCheckBox}" Margin="0,4"
                                  ToolTip="Игнорировать публичные бесплатные узлы и использовать только свои добавленные серверы" />
                        <CheckBox x:Name="TestAfterRefreshCheck" Content="Проверять задержки сразу после обновления списков" Style="{StaticResource AppCheckBox}" Margin="0,4" />
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Защита и статистика" Margin="0,20,0,8" />
                        <CheckBox x:Name="KillSwitchCheck" Content="Kill switch: при падении ядра не выпускать трафик напрямую" Style="{StaticResource AppCheckBox}" Margin="0,4"
                                  ToolTip="Системный прокси останется на закрытом локальном порту: сайты не откроются, но трафик не пойдёт в обход узла. Вернуть интернет — кнопкой «Отключиться»" />
                        <CheckBox x:Name="ShowTrafficCheck" Content="Показывать скорость и трафик в шапке" Style="{StaticResource AppCheckBox}" Margin="0,4" />
                        <CheckBox x:Name="ShowExitInfoCheck" Content="Показывать страну и IP выхода после подключения" Style="{StaticResource AppCheckBox}" Margin="0,4"
                                  ToolTip="Один запрос через узел: полезно видеть, куда выпускает случайный бесплатный сервер" />
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Проверка в простое" Margin="0,20,0,8" />
                        <CheckBox x:Name="IdleTestCheck" Content="Проверять накопившиеся узлы в простое (компьютер не используется)" Style="{StaticResource AppCheckBox}" Margin="0,4"
                                  ToolTip="Лёгкая проверка по 1–2 узла одновременно, только когда окно свёрнуто и нет ввода. При подключённом туннеле проверяются только уже загруженные узлы, без перезапуска ядра" />
                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Простой для проверки, мин" VerticalAlignment="Center" Foreground="{DynamicResource TextSoftBrush}" />
                            <TextBox Grid.Column="1" x:Name="IdleMinutesBox" Style="{StaticResource AppTextBox}" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Узлов за проход" VerticalAlignment="Center" Foreground="{DynamicResource TextSoftBrush}" />
                            <TextBox Grid.Column="1" x:Name="IdleBatchBox" Style="{StaticResource AppTextBox}" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Пауза между проходами, мин" VerticalAlignment="Center" Foreground="{DynamicResource TextSoftBrush}" />
                            <TextBox Grid.Column="1" x:Name="IdleIntervalBox" Style="{StaticResource AppTextBox}" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Перепроверять рабочие, ч" VerticalAlignment="Center" Foreground="{DynamicResource TextSoftBrush}" />
                            <TextBox Grid.Column="1" x:Name="IdleRecheckBox" Style="{StaticResource AppTextBox}"
                                     ToolTip="Рабочие узлы и MTProto старше этого времени перепроверяются, а нерабочие узлы удаляются" />
                        </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Content="Сохранить настройки" Style="{StaticResource PrimaryButton}" Click="OnSaveSettingsClick" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </TabItem>



            <TabItem Header="Журнал" Style="{StaticResource AppTabItem}">
                <DockPanel Margin="16,12,16,16">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Очистить" Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="OnClearLogClick" />
                        <Button Content="Открыть папку журналов" Style="{StaticResource SmallButton}" Click="OnOpenLogsClick" />
                    </StackPanel>
                    <TextBox x:Name="LogBox" Style="{StaticResource AppTextBox}" IsReadOnly="True" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" />
                </DockPanel>
            </TabItem>

            <TabItem x:Name="GeneralTab" Header="Общие" Style="{StaticResource AppTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,12,16,24" MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Приложение" />
                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Общие настройки: поведение окна, тема, папка данных, ядро sing-box и памятка по безопасности." />
                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Foreground="{DynamicResource WarningBrush}"
                                   Text="Статус: бета-версия. Основные режимы проверены, но возможны сбои — для постоянной работы лучше своя подписка или свой сервер." />
                        <CheckBox x:Name="MinimizeTrayCheck" Content="Сворачивать в трей вместо закрытия" Style="{StaticResource AppCheckBox}" Margin="0,4" />
                        <CheckBox x:Name="LightThemeCheck" Content="Светлая тема" Style="{StaticResource AppCheckBox}" Margin="0,4" Checked="OnThemeChanged" Unchecked="OnThemeChanged" />
                        <CheckBox x:Name="AutostartCheck" Content="Запускать VieNLink при входе в Windows (в трее)" Style="{StaticResource AppCheckBox}" Margin="0,4"
                                  Checked="OnAutostartChanged" Unchecked="OnAutostartChanged"
                                  ToolTip="Ключ автозапуска текущего пользователя: права администратора не нужны" />
                        <TextBlock x:Name="AppVersionText" Style="{StaticResource HintText}" Margin="0,10,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Сохранить настройки" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="OnSaveSettingsClick" />
                            <Button Content="Открыть папку данных" Style="{StaticResource BaseButton}" Click="OnOpenDataClick" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Ядро sing-box" Margin="0,24,0,8" />
                        <TextBlock x:Name="CoreStatusText" Style="{StaticResource HintText}" Text="Проверка…" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Проверить / скачать ядро" Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="OnEnsureCoreClick" />
                            <Button Content="Проверить обновление" Style="{StaticResource SmallButton}" Click="OnCheckCoreUpdateClick"
                                    ToolTip="Сравнить установленное ядро с последним релизом sing-box на GitHub и обновить" />
                        </StackPanel>
                        <TextBlock x:Name="CoreUpdateText" Style="{StaticResource HintText}" Margin="0,8,0,0" TextWrapping="Wrap" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Совместимость с приложениями" Margin="0,24,0,8" />
                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                   Text="Приложения из Microsoft Store не видят прокси на 127.0.0.1 из-за изоляции loopback: в браузере сайт открывается, а в приложении — нет. Кнопка ниже снимает это ограничение для всех приложений текущего пользователя (нужны права администратора)." />
                        <Button Content="Разрешить локальный прокси приложениям Магазина" Style="{StaticResource SmallButton}" Margin="0,8,0,0"
                                Click="OnStoreAppsLoopbackClick" />
                        <TextBlock x:Name="StoreLoopbackText" Style="{StaticResource HintText}" Margin="0,6,0,0" TextWrapping="Wrap" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="О безопасности" Margin="0,24,0,8" />
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="Узлы берутся из открытых источников и никем не проверяются: владелец сервера видит ваш трафик так же, как провайдер. Используйте бесплатные узлы для доступа к заблокированным сайтам, но не входите через них в банки и почту, если не доверяете узлу. Соединения по HTTPS остаются зашифрованными до сайта, но сам факт посещения и SNI видны." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Нижняя строка -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource TableGridLineBrush}" BorderThickness="0,1,0,0" Padding="20,8">
            <Grid>
                <TextBlock x:Name="FooterText" Style="{StaticResource HintText}" Text="Готово" />
                <TextBlock HorizontalAlignment="Right" Style="{StaticResource HintText}"
                           Text="Бесплатные узлы не гарантируют скорость и приватность" />
            </Grid>
        </Border>
    </Grid>
</Window>

