<Window x:Class="VieNLink.ZapretWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VieNLink — обход"
        Width="212"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI"
        FontSize="10.5"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Кнопки виджета мельче обычных: панель должна занимать минимум места поверх игры. -->
        <Style x:Key="WidgetButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Padding" Value="6,3" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="9"
            Padding="7">
        <StackPanel>
            <Grid x:Name="Header" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="WidgetDot" Width="8" Height="8" Fill="{DynamicResource DangerBrush}"
                             Margin="0,0,5,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="WidgetTitle" Text="Обход DPI" FontWeight="SemiBold" FontSize="10.5"
                               Foreground="{DynamicResource TextStrongBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="WidgetMiniInfo" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextStrongBrush}" VerticalAlignment="Center"
                               Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="WidgetPinButton" Content="📌" Style="{StaticResource WidgetButton}"
                            Padding="3,0" FontSize="9.5" Margin="0,0,1,0" Click="OnPinClick"
                            ToolTip="Виджет поверх всех окон: включено. Нажмите, чтобы отключить" />
                    <Button x:Name="WidgetCollapseButton" Content="▾" Style="{StaticResource WidgetButton}"
                            Padding="3,0" FontSize="9.5" Margin="0,0,1,0" Click="OnCollapseClick"
                            ToolTip="Свернуть или развернуть виджет" />
                    <Button Content="✕" Style="{StaticResource WidgetButton}"
                            Padding="3,0" FontSize="9.5" Click="OnCloseClick" ToolTip="Скрыть виджет" />
                </StackPanel>
            </Grid>

            <StackPanel x:Name="WidgetBody">
                <UniformGrid Columns="2" Margin="0,6,0,0">
                    <Button x:Name="WidgetYoutubeButton" Style="{StaticResource WidgetButton}" Margin="1"
                            HorizontalContentAlignment="Center" Click="OnYoutubeClick"
                            ToolTip="Подключиться через сервер с доступом к YouTube">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15" Margin="0,0,4,0">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Canvas.Left="1" Canvas.Top="5" Width="22" Height="14"
                                               RadiusX="4" RadiusY="4" Fill="{DynamicResource YouTubeBrush}" />
                                    <Path Fill="#FFFFFFFF" Data="M 9.5,8.5 L 16.5,12 L 9.5,15.5 Z" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="WidgetYoutubeCount" Text="0" VerticalAlignment="Center"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="WidgetDiscordButton" Style="{StaticResource WidgetButton}" Margin="1"
                            HorizontalContentAlignment="Center" Click="OnDiscordClick"
                            ToolTip="Подключиться через сервер с доступом к Discord">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15" Margin="0,0,4,0">
                                <Path Fill="{DynamicResource DiscordBrush}" Stretch="Uniform"
                                      Data="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z" />
                            </Viewbox>
                            <TextBlock x:Name="WidgetDiscordCount" Text="0" VerticalAlignment="Center"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="WidgetUniversalButton" Style="{StaticResource WidgetButton}" Margin="1"
                            HorizontalContentAlignment="Center" Click="OnUniversalClick"
                            ToolTip="Подключиться через универсальный сервер с доступом к Cloudflare">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15" Margin="0,0,4,0">
                                <Path Fill="{DynamicResource UniversalBrush}" Stretch="Uniform"
                                      Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" />
                            </Viewbox>
                            <TextBlock x:Name="WidgetUniversalCount" Text="0" VerticalAlignment="Center"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="WidgetTelegramButton" Style="{StaticResource WidgetButton}" Margin="1"
                            HorizontalContentAlignment="Center" Click="OnTelegramClick"
                            ToolTip="Подключиться через сервер с доступом к Telegram">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15" Margin="0,0,4,0">
                                <Grid Width="24" Height="24">
                                    <Ellipse Width="24" Height="24" Fill="#FFFFFFFF" />
                                    <Path Fill="{DynamicResource TelegramBrush}"
                                          Data="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z" />
                                </Grid>
                            </Viewbox>
                            <TextBlock x:Name="WidgetTelegramCount" Text="0" VerticalAlignment="Center"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <Border Height="1" Background="{DynamicResource TableGridLineBrush}" Margin="0,6,0,4" />

                <UniformGrid Columns="2">
                    <Button x:Name="WidgetZapretButton" Style="{StaticResource WidgetButton}" Margin="1"
                            HorizontalContentAlignment="Center" Click="OnZapretClick"
                            ToolTip="Обход DPI (zapret): стратегия подбирается сама">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M7,2V13H10V22L17,10H13L17,2H7Z" />
                            <TextBlock Text="Zapret" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="WidgetDesyncButton" Style="{StaticResource WidgetButton}" Margin="1"
                            HorizontalContentAlignment="Center" Click="OnDesyncClick"
                            ToolTip="Свой обход DPI на WinDivert: стратегия подбирается сама">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M21,9L17,5V8H10V10H17V13M7,11L3,15L7,19V16H14V14H7V11Z" />
                            <TextBlock Text="Обход DPI" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <TextBlock x:Name="WidgetStatus" FontSize="9"
                           Foreground="{DynamicResource TextSoftBrush}" TextWrapping="Wrap"
                           Margin="1,4,0,0" Text="Ничего не включено — выберите способ" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
