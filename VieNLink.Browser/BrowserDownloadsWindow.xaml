<Window x:Class="VieNLink.BrowserDownloadsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Загрузки — VieNLink" Height="480" Width="860"
        MinHeight="340" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListView x:Name="DownloadList"
                  Background="{DynamicResource PanelBrush}"
                  Foreground="{DynamicResource TextBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  MouseDoubleClick="OnOpenSelected">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Файл" Width="330" DisplayMemberBinding="{Binding FileName}" />
                    <GridViewColumn Header="Состояние" Width="200" DisplayMemberBinding="{Binding State}" />
                    <GridViewColumn Header="Размер" Width="90" DisplayMemberBinding="{Binding SizeLabel}" />
                    <GridViewColumn Header="Когда" Width="80" DisplayMemberBinding="{Binding StartedLabel}" />
                </GridView>
            </ListView.View>
        </ListView>

        <DockPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock x:Name="CountText" VerticalAlignment="Center" FontSize="11"
                       Foreground="{DynamicResource MutedStrongBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OpenButton" Content="Открыть" Style="{StaticResource AccentSmallButton}" Margin="0,0,8,0"
                        Click="OnOpenClick" />
                <Button x:Name="ShowButton" Content="Показать в папке" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                        Click="OnShowClick" />
                <Button x:Name="CancelButton" Content="Отменить" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                        Click="OnCancelClick" />
                <Button Content="Очистить список" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                        Click="OnClearClick" />
                <Button Content="Закрыть" Style="{StaticResource SmallButton}" Click="OnCloseClick" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
