<Window x:Class="VieNLink.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Браузер — VieNLink"
        Icon="pack://application:,,,/Assets/browser-icon.ico"
        Height="880" Width="1340" MinHeight="460" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#FF12181A"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        Closing="OnWindowClosing"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        StateChanged="OnWindowStateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid" Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ContentColumn" Width="*" />
            <ColumnDefinition x:Name="VpnPanelColumn" Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="ContentRoot" Grid.Column="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ВЕРХНЯЯ ПОЛОСА: ВКЛАДКИ И КНОПКИ ОКНА -->
        <Border x:Name="TabBarBorder" Grid.Row="0" Background="{DynamicResource ChromeBackdropBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="8,6,0,0" MouseLeftButtonDown="OnTitleBarMouseDown">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="MenuButton" Margin="0,0,2,0"
                        Style="{StaticResource BrowserToolButton}" Click="OnMenuButtonClick" ToolTip="Меню браузера">
                    <Path Width="14" Height="14" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z" />
                </Button>

                    <Button x:Name="MinimizeButton" Style="{StaticResource WindowChromeButton}"
                            Click="OnMinimizeClick" ToolTip="Свернуть" Content="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource WindowChromeButton}"
                            Click="OnMaximizeClick" ToolTip="Развернуть" Content="&#xE922;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" />
                    <Button x:Name="CloseWindowButton" Style="{StaticResource WindowCloseButton}"
                            Click="OnCloseWindowClick" ToolTip="Закрыть" Content="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" />
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Focusable="False" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel x:Name="TabStrip" Orientation="Horizontal" />
                        <Button x:Name="NewTabButton" Margin="4,0,0,0"
                                Style="{StaticResource BrowserToolButton}"
                                Click="OnNewTabClick" ToolTip="Новая вкладка (Ctrl+T)">
                            <Path Width="12" Height="12" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- АДРЕСНАЯ СТРОКА И КНОПКИ -->
        <Border x:Name="NavBarBorder" Grid.Row="1" Background="{DynamicResource ChromeToolbarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="8,3">
            <DockPanel>
                <Button x:Name="BackButton" DockPanel.Dock="Left" Margin="0,0,2,0"
                        Style="{StaticResource BrowserToolButton}" Click="OnBackClick" ToolTip="Назад (Alt+стрелка влево)">
                    <Path Width="13" Height="13" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" />
                </Button>
                <Button x:Name="ForwardButton" DockPanel.Dock="Left" Margin="0,0,6,0" Visibility="Collapsed"
                        Style="{StaticResource BrowserToolButton}" Click="OnForwardClick" ToolTip="Вперёд (Alt+стрелка вправо)">
                    <Path Width="13" Height="13" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M4,11V13H16L10.5,18.5L11.92,19.92L19.84,12L11.92,4.08L10.5,5.5L16,11H4Z" />
                </Button>

                

                <Button x:Name="ReloadButton" DockPanel.Dock="Left" Margin="0,0,6,0"
                        Style="{StaticResource BrowserToolButton}" Click="OnReloadClick" ToolTip="Обновить (F5)">
                    <Path x:Name="ReloadIcon" Width="14" Height="14" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" />
                </Button>

                <Button x:Name="StarButton" DockPanel.Dock="Right" Margin="2,0,0,0" Visibility="Collapsed"
                        Style="{StaticResource BrowserToolButton}" Click="OnBookmarkClick"
                        ToolTip="Добавить или убрать закладку (Ctrl+D)">
                    <Path x:Name="StarIcon" Width="14" Height="14" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M12,15.39L8.24,17.66L9.23,13.38L5.91,10.5L10.29,10.13L12,6.09L13.71,10.13L18.09,10.5L14.77,13.38L15.76,17.66M22,9.24L14.81,8.63L12,2L9.19,8.63L2,9.24L7.45,13.97L5.82,21L12,17.27L18.18,21L16.54,13.97L22,9.24Z" />
                </Button>

                                <Button x:Name="DownloadsButton" DockPanel.Dock="Right" Margin="2,0,0,0"
                        Style="{StaticResource BrowserToolButton}" Click="OnDownloadsIconClick"
                        ToolTip="Загрузки (Ctrl+J)">
                    <Path Width="14" Height="14" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M12,4 L12,15 M7,10.5 L12,15.5 L17,10.5 M5,19.5 L19,19.5" />
                </Button>
                <Button x:Name="VpnStatusButton" DockPanel.Dock="Right" Margin="2,0,0,0"
                        Style="{StaticResource BrowserToolButton}" Click="OnVpnStatusClick"
                        ToolTip="Панель VPN">
                    <Path x:Name="VpnIcon" Width="14" Height="14" Stretch="Uniform"
                          Fill="{DynamicResource ChromeMutedBrush}"
                          Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,11.99C14.12,11.99 16.07,12.66 17.66,13.82C17.14,18.13 14.89,21.56 12,22.7C9.11,21.56 6.86,18.13 6.34,13.82C7.93,12.66 9.88,11.99 12,11.99M10.83,3.29L12,2.77L13.17,3.29C13.72,3.53 14.2,3.88 14.6,4.32C13.74,4.14 12.87,4.05 12,4.05C11.13,4.05 10.26,4.14 9.4,4.32C9.8,3.88 10.28,3.53 10.83,3.29Z" />
                </Button>

                <Grid Margin="6,0">
                    <TextBox x:Name="AddressBox" Style="{StaticResource BrowserAddressBox}"
                             VerticalAlignment="Center" KeyDown="OnAddressKeyDown"
                             GotKeyboardFocus="OnAddressGotFocus" />
                    <TextBlock x:Name="AddressPlaceholder" IsHitTestVisible="False"
                               Text="Введите адрес или поисковый запрос"
                               Margin="18,0,0,0" VerticalAlignment="Center"
                               Foreground="#FF6F787B"
                               Visibility="Collapsed" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- ПАНЕЛЬ ЗАКЛАДОК -->
        <Border x:Name="BookmarksBarBorder" Grid.Row="2" Visibility="Collapsed"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="8,5">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Focusable="False">
                <StackPanel x:Name="BookmarksStrip" Orientation="Horizontal" />
            </ScrollViewer>
        </Border>

        <!-- ПОИСК ПО СТРАНИЦЕ -->
        <Border x:Name="FindBar" Grid.Row="3" Visibility="Collapsed"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="10,7">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Padding="9,2"
                        Margin="8,0,0,0" Click="OnFindCloseClick" ToolTip="Закрыть поиск (Esc)">
                    <Path Width="11" Height="11" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" />
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Padding="9,2"
                        Margin="8,0,0,0" Click="OnFindPreviousClick" ToolTip="Предыдущее совпадение (Shift+Enter)">
                    <Path Width="11" Height="11" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M7.41,15.41L12,10.83L16.59,15.41L18,14L12,8L6,14L7.41,15.41Z" />
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Padding="9,2"
                        Margin="8,0,0,0" Click="OnFindNextClick" ToolTip="Следующее совпадение (Enter)">
                    <Path Width="11" Height="11" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M7.41,8.59L12,13.17L16.59,8.59L18,10L12,16L6,10L7.41,8.59Z" />
                </Button>
                <TextBlock x:Name="FindCount" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Margin="10,0,0,0" FontSize="11.5" Foreground="{DynamicResource MutedStrongBrush}" />
                <TextBox x:Name="FindBox" Style="{StaticResource AppTextBox}" Width="320"
                         HorizontalAlignment="Left" KeyDown="OnFindBoxKeyDown" />
            </DockPanel>
        </Border>

        <!-- ХОД ЗАГРУЗКИ -->
        <ProgressBar x:Name="LoadProgress" Grid.Row="4" Height="3" Minimum="0" Maximum="100"
                     Visibility="Collapsed" IsIndeterminate="True" BorderThickness="0"
                     Background="Transparent" Foreground="{DynamicResource AccentBrush}" />

        <!-- СТРАНИЦА -->
        <Grid x:Name="ContentHost" Grid.Row="5" Background="#FF12181A" />

        <!-- СТРОКА СОСТОЯНИЯ -->
        <Border x:Name="StatusBar" Grid.Row="6" Visibility="Collapsed" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="10,4">
            <DockPanel>
                <TextBlock x:Name="ZoomText" DockPanel.Dock="Right" Margin="10,0,0,0"
                           FontSize="11" Foreground="{DynamicResource MutedBrush}" />

                <TextBlock x:Name="StatusText" FontSize="11" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource MutedStrongBrush}" />
            </DockPanel>
        </Border>

        </Grid>

        <!-- МЕНЮ ☰ -->
        <Popup x:Name="BrowserMenuPopup" PlacementTarget="{Binding ElementName=MenuButton}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="330" Margin="0,6,0,0" Background="#F224292C" BorderBrush="#33FFFFFF"
                    BorderThickness="1" CornerRadius="12" Padding="6">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.45" Color="#000000" />
                </Border.Effect>
                <StackPanel x:Name="BrowserMenuPanel" />
            </Border>
        </Popup>

        <!-- ПАНЕЛЬ VPN -->
        <Border x:Name="VpnPanel" Grid.Column="1" Width="320" Visibility="Collapsed"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="12,10" Background="{DynamicResource HeaderBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button x:Name="VpnClosePanelButton" DockPanel.Dock="Right" Style="{StaticResource SmallButton}"
                                Padding="7,1" Margin="6,0,0,0" Click="OnVpnPanelCloseClick" ToolTip="Закрыть панель">
                            <Path Width="10" Height="10" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" />
                        </Button>
                        <Button x:Name="VpnDockButton" DockPanel.Dock="Right" Style="{StaticResource SmallButton}"
                                Padding="7,1" Margin="6,0,0,0" Click="OnVpnDockClick"
                                ToolTip="Переставить панель к другому краю окна">
                            <Path Width="12" Height="12" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M17,7H7V17H17V7M4,3H20A1,1 0 0,1 21,4V20A1,1 0 0,1 20,21H4A1,1 0 0,1 3,20V4A1,1 0 0,1 4,3Z" />
                        </Button>
                        <TextBlock Text="VieNLink VPN" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </DockPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <Border Style="{StaticResource InstructionCard}">
                            <StackPanel>
                                <TextBlock x:Name="VpnStateText" Text="Не подключён" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock x:Name="VpnServerText" Style="{StaticResource HintText}"
                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="VpnConnectButton" Content="Подключиться"
                                            Style="{StaticResource PrimaryButton}" Click="OnVpnConnectClick" />
                                    <Button x:Name="VpnSwitchButton" Content="Другой сервер"
                                            Style="{StaticResource AccentSmallButton}" Margin="8,0,0,0"
                                            Click="OnVpnSwitchClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <CheckBox x:Name="VpnOnlyCheck" Style="{StaticResource AppCheckBox}" Margin="0,14,0,0"
                                  Content="Только через VPN" Click="OnVpnOnlyChanged" />
                        <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Без подключения страницы не открываются — реальный IP не утечёт." />

                        <Button x:Name="VpnInstallButton" Content="Установить VPN" Visibility="Collapsed"
                                Style="{StaticResource AccentSmallButton}" Margin="0,10,0,0"
                                HorizontalAlignment="Left" Click="OnVpnInstallClick" />
                        <TextBlock x:Name="VpnConnectionHintText" Style="{StaticResource HintText}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" />

                        <TextBlock Text="Сервисы" Style="{StaticResource SectionTitle}" Margin="0,18,0,6" />
                        <WrapPanel x:Name="VpnServicesPanel" />

                        <TextBlock Text="Обход блокировок" Style="{StaticResource SectionTitle}" Margin="0,18,0,6" />
                        <TextBlock x:Name="VpnBypassText" Style="{StaticResource HintText}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="VpnZapretButton" Content="zapret" Style="{StaticResource SmallButton}"
                                    Click="OnVpnZapretClick" />
                            <Button x:Name="VpnDesyncButton" Content="Свой движок" Style="{StaticResource SmallButton}"
                                    Margin="8,0,0,0" Click="OnVpnDesyncClick" />
                        </StackPanel>

                        <Button Content="Открыть VieNLink" Style="{StaticResource SmallButton}" Margin="0,18,0,0"
                                HorizontalAlignment="Left" Click="OnVpnOpenMainClick" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>