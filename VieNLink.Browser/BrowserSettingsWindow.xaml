<Window x:Class="VieNLink.BrowserSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки браузера" Height="720" Width="620"
        MinHeight="460" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Запуск" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                           Text="Домашняя страница: пусто — стартовая страница VieNLink (поиск Google и закладки)." />
                <TextBox x:Name="HomeBox" Style="{StaticResource AppTextBox}" Margin="0,8,0,0" />
                <CheckBox x:Name="RestoreCheck" Style="{StaticResource AppCheckBox}" Margin="0,12,0,0"
                          Content="Открывать вкладки прошлой сессии" />
                <CheckBox x:Name="ClearDataCheck" Style="{StaticResource AppCheckBox}" Margin="0,8,0,0"
                          Content="Очищать кэш, cookie и данные сайтов при запуске" />

                <TextBlock Text="Вид" Style="{StaticResource SectionTitle}" Margin="0,22,0,6" />
                <TextBlock Style="{StaticResource HintText}" Text="Масштаб страниц по умолчанию." />
                <WrapPanel x:Name="ZoomPanel" Margin="0,8,0,0" />
                <CheckBox x:Name="BookmarksBarCheck" Style="{StaticResource AppCheckBox}" Margin="0,12,0,0"
                          Content="Панель закладок под адресной строкой" />
                <CheckBox x:Name="FaviconsCheck" Style="{StaticResource AppCheckBox}" Margin="0,8,0,0"
                          Content="Значки сайтов во вкладках" />
                <CheckBox x:Name="LinkStatusCheck" Style="{StaticResource AppCheckBox}" Margin="0,8,0,0"
                          Content="Показывать адрес ссылки в строке состояния" />

                <TextBlock Text="Поведение" Style="{StaticResource SectionTitle}" Margin="0,22,0,6" />
                <CheckBox x:Name="CloseLastTabCheck" Style="{StaticResource AppCheckBox}"
                          Content="Закрывать окно вместе с последней вкладкой" />
                <CheckBox x:Name="HistoryCheck" Style="{StaticResource AppCheckBox}" Margin="0,8,0,0"
                          Content="Вести историю посещений" />

                <TextBlock Text="Приватность" Style="{StaticResource SectionTitle}" Margin="0,22,0,6" />
                <CheckBox x:Name="VpnOnlySettingsCheck" Style="{StaticResource AppCheckBox}"
                          Content="Открывать страницы только при подключённом VPN" />
                <CheckBox x:Name="AutoConnectCheck" Style="{StaticResource AppCheckBox}" Margin="0,8,0,0"
                          Content="Если страница не открылась — подключать VPN автоматически" />
                <CheckBox x:Name="BlockPermissionsCheck" Style="{StaticResource AppCheckBox}" Margin="0,8,0,0"
                          Content="Запрещать камеру, микрофон, геолокацию и уведомления" />
                <CheckBox x:Name="AutofillCheck" Style="{StaticResource AppCheckBox}" Margin="0,8,0,0"
                          Content="Автозаполнение форм и сохранение паролей" />

                <TextBlock Text="Дополнительно" Style="{StaticResource SectionTitle}" Margin="0,22,0,6" />
                <CheckBox x:Name="JavaScriptCheck" Style="{StaticResource AppCheckBox}"
                          Content="JavaScript на страницах" />
                <CheckBox x:Name="DevToolsCheck" Style="{StaticResource AppCheckBox}" Margin="0,8,0,0"
                          Content="Инструменты разработчика (F12)" />
                <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0" TextWrapping="Wrap"
                           Text="Настройки хранятся в %LOCALAPPDATA%\VieNLink\browser.json. Часть изменений применяется сразу, очистка при запуске — со следующего открытия." />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="OnSaveClick" Margin="0,0,8,0" />
            <Button Content="Отмена" Style="{StaticResource SmallButton}" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
