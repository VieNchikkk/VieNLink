<Window x:Class="VieNLink.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VieNLink"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{DynamicResource TextBrush}">
    <Border Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="20"
            MinWidth="380"
            MaxWidth="580">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="7" Opacity="0.45" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource AccentSurfaceBrush}"
                            BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1">
                        <TextBlock Text="V" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="TitleText" Text="VieNLink" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextStrongBrush}" Margin="9,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="CloseButton" Content="✕" Style="{StaticResource SmallButton}"
                        Padding="9,2" FontSize="12" Click="OnCloseClick" ToolTip="Закрыть" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="IconBadge" Width="42" Height="42" CornerRadius="21" VerticalAlignment="Top"
                        Background="{DynamicResource AccentSurfaceBrush}">
                    <TextBlock x:Name="IconText" Text="i" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ScrollViewer Grid.Column="1" MaxHeight="330" VerticalScrollBarVisibility="Auto" Margin="14,0,0,0">
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13" LineHeight="19"
                               Foreground="{DynamicResource TextSoftBrush}" />
                </ScrollViewer>
            </Grid>

            <StackPanel Grid.Row="2" x:Name="ButtonsPanel" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,20,0,0" />
        </Grid>
    </Border>
</Window>
