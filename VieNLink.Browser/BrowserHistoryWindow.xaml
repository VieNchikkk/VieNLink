<Window x:Class="VieNLink.BrowserHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История — VieNLink" Height="560" Width="820"
        MinHeight="380" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{DynamicResource MutedStrongBrush}" />
            <TextBox x:Name="SearchBox" Style="{StaticResource AppTextBox}" TextChanged="OnSearchChanged" />
        </DockPanel>

        <ListView x:Name="HistoryList" Grid.Row="1" Margin="0,10,0,10"
                  Background="{DynamicResource PanelBrush}"
                  Foreground="{DynamicResource TextBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  MouseDoubleClick="OnOpenSelected">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Заголовок" Width="320" DisplayMemberBinding="{Binding Title}" />
                    <GridViewColumn Header="Адрес" Width="300" DisplayMemberBinding="{Binding Url}" />
                    <GridViewColumn Header="Когда" Width="140" DisplayMemberBinding="{Binding VisitedLabel}" />
                </GridView>
            </ListView.View>
        </ListView>

        <DockPanel Grid.Row="2">
            <TextBlock x:Name="CountText" VerticalAlignment="Center" FontSize="11"
                       Foreground="{DynamicResource MutedStrongBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Открыть" Style="{StaticResource AccentSmallButton}" Margin="0,0,8,0"
                        Click="OnOpenClick" />
                <Button Content="Удалить" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                        Click="OnDeleteClick" />
                <Button Content="Очистить историю" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                        Click="OnClearClick" />
                <Button Content="Закрыть" Style="{StaticResource SmallButton}" Click="OnCloseClick" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
