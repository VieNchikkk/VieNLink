<Project Sdk="Microsoft.NET.Sdk">

  <!-- Единая версия Windows и Android: build\Version.props. -->
  <Import Project="..\build\Version.props" />

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VieNLink.Mobile</RootNamespace>
    <AssemblyName>VieNLink.Android</AssemblyName>

    <!-- TestBuild — отдельная тестовая сборка: другой package и имя, чтобы стоять
         рядом с обычным клиентом. AndroidJavaPlatform — Java-реализация PlatformInterface.
         С 24.11.2026 Java-платформа включена во все сборки по умолчанию: на телефоне
         она не даёт зависаний MonoVM после фона, проверена на телефоне, планшете и ТВ. -->
    <TestBuild Condition="'$(TestBuild)' == ''">false</TestBuild>
    <TvBuild Condition="'$(TvBuild)' == ''">false</TvBuild>
    <AndroidJavaPlatform Condition="'$(AndroidJavaPlatform)' == ''">true</AndroidJavaPlatform>
    <ApplicationId Condition="'$(TvBuild)' != 'true' and '$(TestBuild)' != 'true'">com.vienlink.app</ApplicationId>
    <ApplicationId Condition="'$(TvBuild)' != 'true' and '$(TestBuild)' == 'true'">com.vienlink.app.test</ApplicationId>
    <ApplicationId Condition="'$(TvBuild)' == 'true'">com.vienlink.app.tv</ApplicationId>
    <ApplicationVersion>$(VieNLinkVersionCode)</ApplicationVersion>
    <ApplicationDisplayVersion>$(VieNLinkVersion)</ApplicationDisplayVersion>
    <Version>$(VieNLinkVersion)</Version>

    <!-- StoreBuild — сборка для магазина: без REQUEST_INSTALL_PACKAGES и самообновления.
         GitHub-APK собирается по умолчанию (StoreBuild=false) и сохраняет автообновление. -->
    <StoreBuild Condition="'$(StoreBuild)' == ''">false</StoreBuild>

    <!-- Ядро (libbox.aar) кладётся в Libs: см. docs/android-design.md §4 и доку Android. -->
    <AndroidAarLibrariesDirectory>Libs</AndroidAarLibrariesDirectory>

    <!-- Debug-сборка тоже должна быть самодостаточной: APK ставим вручную через adb,
         без Fast Deployment (иначе приложение падает с «No assemblies found»). -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>

    <!-- Android 11 (Lenovo TB-J706F): Release с AOT падает SIGSEGV через секунду
         после старта; с JIT (как Debug) работает. Для планшетов и ТВ AOT выключаем. -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(StoreBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);STORE_BUILD</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TestBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);TEST_BUILD</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TvBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);TV_BUILD</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AndroidJavaPlatform)' == 'true'">
    <DefineConstants>$(DefineConstants);JAVA_PLATFORM</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VieNLink.Core\VieNLink.Core.csproj" />
    <!-- Названия стран общие с Windows-версией: файл не зависит от WPF. -->
    <Compile Include="..\VieNLink\CountryNames.cs" Link="CountryNames.cs" />
  </ItemGroup>

  <!-- Самообновление APK разрешено только в GitHub-сборке. В магазинной сборке
       разрешения нет: Play и RuStore запрещают приложению ставить обновления само. -->
  <ItemGroup Condition="'$(StoreBuild)' != 'true'">
    <AndroidManifestOverlay Include="Store\SideloadManifest.xml" />
  </ItemGroup>

  <!-- Android TV: LEANBACK_LAUNCHER, баннер, альбомная ориентация, без обязательного тача. -->
  <ItemGroup Condition="'$(TvBuild)' == 'true'">
    <AndroidManifestOverlay Include="Store\TvManifest.xml" />
  </ItemGroup>

  <ItemGroup>
    <AndroidAarLibrary Include="Libs\*.aar" />
  </ItemGroup>

  <!-- Java-платформа libbox: в тестовой сборке ядро вызывает Java, а не C#. -->
  <ItemGroup Condition="'$(AndroidJavaPlatform)' == 'true'">
    <AndroidJavaSource Include="Java\**\*.java" />
    <ProguardConfiguration Include="keep-java.txt" />
  </ItemGroup>

  <!-- Переменные окружения среды выполнения (Mono). Нужны из-за дедлока остановки
       мира: приложение зависало в фоне, см. docs/plan-2026.md от 23.11.2026. -->
  <ItemGroup>
    <AndroidEnvironment Include="Environment.txt" />
  </ItemGroup>

  <!-- Тексты лицензий кладём в APK: GPL-3.0 и сторонние компоненты. -->
  <ItemGroup>
    <AndroidAsset Include="..\LICENSE" Link="Assets\LICENSE.txt" />
    <AndroidAsset Include="..\THIRD-PARTY-NOTICES.md" Link="Assets\THIRD-PARTY-NOTICES.md" />
    <!-- Стартовый набор серверов: генерируется режимом SelfTest `exportseed` перед релизом.
         В обычной/тестовой сборке файла может не быть — тогда APK без seed. -->
    <AndroidAsset Include="..\seed.txt" Link="Assets\seed.txt" Condition="Exists('..\seed.txt')" />
  </ItemGroup>

</Project>
