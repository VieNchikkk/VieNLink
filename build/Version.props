<Project>
  <!--
    ЕДИНАЯ ВЕРСИЯ Windows и Android. Менять номер только здесь.
    Windows берёт Version / FileVersion / InformationalVersion,
    Android — ApplicationDisplayVersion и ApplicationVersion (versionCode).

    versionCode Android = major*10000 + minor*100 + patch:
      1.3.0 -> 10300
      1.3.1 -> 10301
      1.3.2 -> 10302
      1.3.3 -> 10303
      1.4.0 -> 10400
    При смене версии обязательно обновите VieNLinkVersionCode: он должен только расти.
  -->
  <PropertyGroup>
    <VieNLinkVersion>1.3.3</VieNLinkVersion>
    <VieNLinkVersionCode>10303</VieNLinkVersionCode>
    <VieNLinkIsBeta>true</VieNLinkIsBeta>
  </PropertyGroup>
</Project>
