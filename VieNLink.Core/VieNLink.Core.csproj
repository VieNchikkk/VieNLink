<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VieNLink</RootNamespace>
    <AssemblyName>VieNLink.Core</AssemblyName>
    <Version>1.0.5</Version>
    <NeutralLanguage>ru-RU</NeutralLanguage>
    <Description>Общее ядро VieNLink: разбор ссылок и подписок, источники, рейтинг узлов, сборка конфига sing-box, проверка задержки и форвардер с фрагментацией TLS. Без привязки к Windows — используется Windows- и Android-версиями.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VieNLink" />
    <InternalsVisibleTo Include="VieNLink.SelfTest" />
    <InternalsVisibleTo Include="VieNLink.Android" />
    <InternalsVisibleTo Include="VieNLink.Browser" />
  </ItemGroup>

  <ItemGroup>
    <!-- Шаблон фейкового QUIC Initial (zapret): безобидный SNI www.google.com. -->
    <EmbeddedResource Include="Assets\quic_initial_www_google_com.bin" />
    <!-- Зашитая база параметров обхода по операторам: пополняется из экспорта приложения. -->
    <EmbeddedResource Include="Assets\provider-presets.json" />
  </ItemGroup>

</Project>
